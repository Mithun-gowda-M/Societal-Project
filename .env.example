# BloodConnect 2026 — Real Email & SMS Gateway Configuration Template

# -----------------------------------------------------------------------------
# 1. REAL EMAIL CONFIGURATION (Google Gmail / Outlook / Custom SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bloodconnectai@gmail.com
SMTP_PASS=your_16_character_app_password
FROM_EMAIL="BloodConnect Automated Gateway" <bloodconnectai@gmail.com>

# -----------------------------------------------------------------------------
# 2. REAL SMS CONFIGURATION (Twilio OR Fast2SMS)
# -----------------------------------------------------------------------------
# Option A: Twilio (Global SMS)
SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option B: Fast2SMS (Indian +91 Numbers without DLT)
FAST2SMS_API_KEY=
